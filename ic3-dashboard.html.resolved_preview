<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IC3 Quiz Dashboard – WIT Education</title>
@@MANUAL_CONFLICT_1@@
<link rel="stylesheet" href="css/theme.css">
<link rel="stylesheet" href="css/dashboard.css">
</head>
<body>

<!-- ========================================
     SIDEBAR
     ======================================== -->
<aside id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">🎮</div>
    <div class="logo-text">IC3 Quiz
      <span>WIT Education</span>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-item active" data-section="my-sets">
      <span class="nav-icon">📚</span>
      <span>Bộ đề của tôi</span>
    </div>
    <div class="nav-item" data-section="reports">
      <span class="nav-icon">📊</span>
      <span>Báo cáo kết quả</span>
    </div>
    <div class="nav-item" data-section="settings">
      <span class="nav-icon">⚙️</span>
      <span>Cài đặt hệ thống</span>
    </div>
    <a class="nav-item" href="image-manager.html" style="text-decoration:none;color:inherit;">
      <span class="nav-icon">🖼️</span>
      <span>Quản lý hình ảnh câu hỏi</span>
    </a>
@@MANUAL_CONFLICT_2@@
      </div>
    </div>
  </div>
</aside>

<!-- Sidebar overlay for mobile -->
<div id="sidebar-overlay"></div>

<!-- ========================================
     MAIN WRAPPER
     ======================================== -->
<div id="main-wrapper">

  <!-- TOPBAR -->
  <header id="topbar">
    <div style="display:flex;align-items:center;gap:14px;">
@@MANUAL_CONFLICT_3@@
      <div class="topbar-title" id="topbar-title">📚 Bộ đề của tôi</div>
    </div>
    <div class="topbar-right">
      <a href="index.html" target="_blank" rel="noopener"
         style="display:inline-flex;align-items:center;gap:6px;padding:.5rem 1rem;border-radius:999px;
                background:var(--accent-purple-light);color:var(--accent-purple);font-weight:700;
                font-size:.85rem;text-decoration:none;white-space:nowrap;">
        🎓 Xem trang học sinh
      </a>
      <div class="theme-toggle" id="themeToggle" title="Chuyển đổi sáng/tối"></div>
    </div>
  </header>

  <!-- CONTENT -->
  <main id="content">

    <!-- ========================================
         MY SETS SECTION
         ======================================== -->
    <section class="section active" id="section-my-sets">
      <!-- Toolbar -->
      <div class="toolbar">
@@MANUAL_CONFLICT_4@@
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="Tìm kiếm bộ đề..." oninput="filterCards()">
        </div>
        <div class="filter-group">
@@MANUAL_CONFLICT_5@@
        </div>
      </div>

      <!-- Cards Grid -->
      <div class="cards-grid" id="cardsGrid"></div>
    </section>

    <!-- ========================================
         REPORTS SECTION
         ======================================== -->
    <section class="section" id="section-reports">
      <div class="reports-header">
        <h2>📊 Báo cáo kết quả</h2>
@@MANUAL_CONFLICT_6@@
      </div>

      <!-- Stats Row -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-icon">🧑‍🎓</div>
          <div class="stat-label">Tổng lượt làm</div>
          <div class="stat-value" id="totalSessions">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">✅</div>
          <div class="stat-label">Hoàn thành</div>
          <div class="stat-value" id="totalDone">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">⭐</div>
          <div class="stat-label">Điểm TB</div>
          <div class="stat-value" id="avgScore">—</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🏆</div>
          <div class="stat-label">Điểm cao nhất</div>
          <div class="stat-value" id="topScore">—</div>
        </div>
      </div>

      <!-- Table -->
      <div class="report-table-wrap">
        <div class="report-table-header">🗂️ Chi tiết lượt làm bài</div>
        <div style="overflow-x:auto;">
          <table id="reportTable">
            <thead>
              <tr>
@@MANUAL_CONFLICT_7@@
              </tr>
            </thead>
            <tbody id="reportBody">
              <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:32px;">Chưa có dữ liệu. Học sinh bắt đầu làm bài để xem kết quả.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ========================================
         SETTINGS SECTION
         ======================================== -->
    <section class="section" id="section-settings">
      <h2 style="font-family:'Baloo 2',cursive;font-size:22px;font-weight:800;margin-bottom:24px;">⚙️ Cài đặt hệ thống</h2>
      <div class="settings-grid">
        <div class="settings-card">
@@MANUAL_CONFLICT_8@@
          </div>
        </div>
        <div class="settings-card">
          <h3>🎨 Giao diện</h3>
          <div class="settings-row">
            <label>Chế độ tối (Dark Mode)</label>
@@MANUAL_CONFLICT_9@@
          </div>
        </div>
        <div class="settings-card">
          <h3>ℹ️ Thông tin hệ thống</h3>
          <div class="settings-row"><label>Phiên bản</label><span style="font-weight:800;font-size:13px;">v2.0.2025</span></div>
          <div class="settings-row"><label>Năm học</label><span style="font-weight:800;font-size:13px;">2025–2026</span></div>
          <div class="settings-row"><label>Nền tảng</label><span style="font-weight:800;font-size:13px;">IC3 GS5</span></div>
          <div class="settings-row"><label>Đơn vị</label><span style="font-weight:800;font-size:13px;">WIT Education</span></div>
        </div>
      </div>
    </section>

  </main>
</div>

<!-- ========================================
     CREATE MODAL
     ======================================== -->
<div id="modal-overlay" onclick="closeModalOnOverlay(event)">
  <div class="modal" id="modal-box">
    <div class="modal-header">
      <h3 id="modal-title">➕ Tạo bộ đề mới</h3>
@@MANUAL_CONFLICT_10@@
    </div>
    <div class="modal-body" id="modal-body">
      <!-- dynamically filled -->
    </div>
    <div class="modal-footer" id="modal-footer">
@@MANUAL_CONFLICT_11@@
    </div>
  </div>
</div>

<!-- SESSION TOAST -->
<div id="session-toast">
  <span class="toast-icon">🚀</span>
  <span id="toast-text">Đang ghi nhận phiên làm bài...</span>
</div>

<!-- ========================================
     JAVASCRIPT
     ======================================== -->
<script>window.EDU_ALLOWED_ROLES = ['admin', 'teacher'];</script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
<script src="js/firebase-config.js"></script>
<script src="js/auth.js"></script>
<script src="js/auth-guard.js"></script>
<script src="js/idle-logout.js"></script>
<script>
  window.addEventListener('edu:ready', ({ detail }) => {
    const { user, profile } = detail;
    document.getElementById('userChipName').textContent = profile.name || user.email;
    document.getElementById('userChipRole').textContent = EduAuth.ROLE_LABEL[profile.role] || profile.role;
    if (profile.role === 'admin') {
      document.getElementById('adminUsersLink').style.display = 'flex';
    }
    document.getElementById('userChip').addEventListener('click', async () => {
      if (confirm('Đăng xuất khỏi EduQuiz?')) {
        await EduAuth.logoutUser();
        window.location.href = 'login.html';
      }
    });
  });
</script>
<script src="js/dashboard.js"></script>
</body>
</html>
