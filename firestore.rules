rules_version = '2';

// ============================================================
// Firestore Security Rules — EduQuiz IC3
// Dán toàn bộ nội dung file này vào Firebase Console → Firestore
// Database → Rules, rồi bấm "Publish".
//
// Vai trò (role): "admin" | "teacher" | "student"
// - admin: toàn quyền.
// - teacher: chỉ được sửa collection "questions" SAU KHI được admin
//   duyệt (approved == true). Không được tự đổi role/approved của mình.
// - student: chỉ đọc, không ghi được questions/users của người khác.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }
    function isApprovedTeacher() {
      return isSignedIn() && myProfile().role == 'teacher' && myProfile().approved == true;
    }
    function isEditor() {
      return isAdmin() || isApprovedTeacher();
    }

    // ---- Tài khoản người dùng & phân quyền ----
    match /users/{userId} {
      allow read: if isSignedIn();

      // Tự đăng ký: chỉ được tạo hồ sơ của chính mình, role student|teacher,
      // và không được tự "approved: true" nếu xin làm teacher.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role in ['student', 'teacher']
        && (
          (request.resource.data.role == 'student' && request.resource.data.approved == true) ||
          (request.resource.data.role == 'teacher' && request.resource.data.approved == false)
        );

      // Admin có thể sửa bất kỳ hồ sơ nào (đổi role, duyệt teacher...).
      // Người dùng thường chỉ được sửa hồ sơ CHÍNH MÌNH và KHÔNG được đổi role/approved.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approved == resource.data.approved
      );

      allow delete: if isAdmin();
    }

    // ---- Ngân hàng câu hỏi (dùng bởi image-manager.html) ----
    match /questions/{questionId} {
      allow read: if true; // trang học sinh / app quiz có thể đọc công khai
      allow write: if isEditor();
    }
  }
}
