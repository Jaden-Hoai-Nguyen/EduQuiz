<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
@@MANUAL_CONFLICT_1@@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/theme.css">
<link rel="stylesheet" href="css/image-manager.css">
</head>
<body>

<div class="topbar">
  <a href="ic3-dashboard.html" class="btn btn-ghost btn-sm" style="text-decoration:none;display:inline-flex;align-items:center;gap:4px;">← Dashboard</a>
@@MANUAL_CONFLICT_2@@
</div>

<div class="wrap">

  <div class="banner">
@@MANUAL_CONFLICT_3@@

  <div id="app" style="display:none">
    <div class="stats">
      <div class="stat-card"><div class="n" id="statTotal">0</div><div class="l">Tổng số câu</div></div>
      <div class="stat-card need"><div class="n" id="statNeed">0</div><div class="l">Cần ảnh (chưa có)</div></div>
      <div class="stat-card have"><div class="n" id="statHave">0</div><div class="l">Đã có ảnh thật</div></div>
      <div class="stat-card skip"><div class="n" id="statSkip">0</div><div class="l">Không cần minh hoạ</div></div>
    </div>

    <div class="filters">
      <input type="text" id="searchBox" placeholder="🔍 Tìm theo nội dung câu hỏi...">
      <select id="gradeFilter"><option value="">Tất cả khối</option></select>
      <select id="minitestFilter"><option value="">Tất cả Minitest</option></select>
      <div class="chip-group" id="statusChips">
        <div class="chip active" data-status="">Tất cả</div>
        <div class="chip" data-status="need">Cần ảnh</div>
        <div class="chip" data-status="have">Đã có ảnh</div>
        <div class="chip" data-status="skip">Không cần</div>
      </div>
@@MANUAL_CONFLICT_4@@
    <div id="qlist" class="qlist"></div>
    <div id="emptyState" class="empty-state" style="display:none">Không có câu hỏi nào khớp bộ lọc 🎈</div>

    <div class="pager">
@@MANUAL_CONFLICT_5@@
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>window.EDU_ALLOWED_ROLES = ['admin', 'teacher'];</script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
<script src="js/firebase-config.js"></script>
<script src="js/auth.js"></script>
<script src="js/auth-guard.js"></script>
<script src="js/idle-logout.js"></script>
<script src="js/image-manager.js"></script>
</body>
</html>
