<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>🌟 EduQuiz IC3 – Luyện Thi Vui Vẻ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/theme.css">
<link rel="stylesheet" href="style.css">
</head>
<body>

<!-- ── Theme toggle ── -->
@@MANUAL_CONFLICT_1@@

<!-- ── Lối vào khu quản trị (chỉ hiện ở màn lobby, ẩn lúc làm bài) ── -->
<a href="ic3-dashboard.html" target="_blank" rel="noopener" id="adminEntryLink"
   title="Dành cho giáo viên / quản trị viên"
   style="position:fixed;top:18px;left:18px;z-index:500;font-size:.78rem;font-weight:700;
          color:var(--muted);text-decoration:none;display:flex;align-items:center;gap:4px;
          padding:.4rem .7rem;border-radius:100px;background:var(--card);border:1.5px solid var(--border);
          box-shadow:var(--shadow);transition:all .2s;">
  🔑 <span class="admin-link-label">Quản trị</span>
</a>

<!-- ═══════════════════════════════════
     LOBBY — Two-column layout
     ═══════════════════════════════════ -->
<div id="lobby">
  <!-- Left: branding + features -->
  <div class="lobby-left">
    <div class="lobby-star-row">⭐🎓⭐</div>
    <div class="lobby-logo">EduQuiz IC3</div>
    <div class="lobby-tagline">Luyện thi IC3 · Vui vẻ · Sinh động · Dễ dùng</div>

    <div class="lobby-features">
      <div class="feature-pill">
        <span class="pill-icon">📝</span>
        <span class="pill-text">
          <span class="pill-title">Đa dạng câu hỏi</span>
          <span class="pill-sub">Trắc nghiệm, Đúng/Sai, Nối cột</span>
        </span>
      </div>
      <div class="feature-pill">
        <span class="pill-icon">⏱️</span>
        <span class="pill-text">
          <span class="pill-title">Tính giờ tự động</span>
          <span class="pill-sub">Nộp bài khi hết thời gian</span>
        </span>
      </div>
      <div class="feature-pill">
        <span class="pill-icon">📊</span>
        <span class="pill-text">
          <span class="pill-title">Lưu kết quả</span>
          <span class="pill-sub">Xem lại lịch sử bài làm</span>
        </span>
      </div>
      <div class="feature-pill">
        <span class="pill-icon">🏆</span>
        <span class="pill-text">
          <span class="pill-title">Chấm điểm ngay</span>
          <span class="pill-sub">Xem đúng/sai sau khi nộp</span>
        </span>
      </div>
    </div>

    <!-- Streak / XP / huy hiệu của học sinh trên MÁY này (js/gamification.js) -->
    <div id="lobbyGameStrip" style="margin-top:18px;"></div>
  </div>

  <!-- Right: form -->
  <div class="lobby-right">
    <div class="lobby-card">
      <div class="lobby-card-title"><span>🚀</span> Bắt đầu làm bài</div>

      <!-- Row 1: Tên + Lớp -->
      <div class="form-row">
        <div class="form-group">
          <label>👤 Họ và tên</label>
          <input type="text" id="studentName" placeholder="Nhập tên của bạn..." autocomplete="off">
        </div>
        <div class="form-group">
          <label>🏫 Lớp</label>
          <input type="text" id="studentClass" placeholder="6A1, 7B2..." autocomplete="off">
        </div>
      </div>

      <!-- Row 2: Trường (full width) -->
      <div class="form-group">
        <label>🏛️ Trường</label>
        <input type="text" id="studentSchool" placeholder="Nhập tên trường của bạn..." autocomplete="off">
      </div>

      <!-- Row 3: Danh mục + Cấp độ -->
      <div class="form-row">
        <div class="form-group">
          <label>📚 Danh mục</label>
          <select id="categorySelect"></select>
        </div>
        <div class="form-group">
          <label>🎯 Cấp độ</label>
          <select id="levelSelect"></select>
        </div>
      </div>

      <!-- Row 4: Minitest + Thời gian -->
      <div class="form-row">
        <div class="form-group">
          <label>📝 Minitest</label>
          <select id="minitestSelect"></select>
          <div class="minitest-meta" id="minitestMeta"></div>
        </div>
        <div class="form-group">
          <label>⏰ Thời gian</label>
          <select id="timeSelect">
            <option value="1200">20 phút</option>
            <option value="1800">30 phút</option>
            <option value="2700">45 phút</option>
            <option value="3600">60 phút</option>
            <option value="600">10 phút (Demo)</option>
          </select>
        </div>
      </div>

@@MANUAL_CONFLICT_2@@
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════
     EXAM
     ═══════════════════════════════════ -->
<div id="exam">
  <div class="topbar">
    <div class="topbar-brand">🎓 IC3</div>
    <div class="topbar-info" id="topbarInfo"></div>
    <div class="timer-wrap">
      <span class="timer-icon">⏱</span>
      <span id="timer-display">20:00</span>
    </div>
@@MANUAL_CONFLICT_3@@
      style="background:none;border:1.5px solid var(--border);border-radius:50%;width:36px;height:36px;
             font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;
             flex-shrink:0;transition:all .2s;color:var(--text);"
      id="themeToggleExam" onmouseover="this.style.borderColor='var(--purple)'" onmouseout="this.style.borderColor='var(--border)'">🌙</button>
  </div>
  <div class="progress-bar-wrap"><div class="progress-bar-fill" id="progressFill" style="width:0%"></div></div>
  <div class="exam-body">
    <div class="sidebar">
      <div class="sidebar-title">📋 Câu hỏi</div>
      <div class="q-grid" id="qGrid"></div>
      <div class="legend">
        <div class="legend-item"><div class="legend-dot answered"></div> Đã trả lời</div>
        <div class="legend-item"><div class="legend-dot flagged"></div> Đánh dấu</div>
        <div class="legend-item"><div class="legend-dot unanswered"></div> Chưa trả lời</div>
      </div>
    </div>
    <div class="q-panel" id="qPanel"></div>
  </div>
</div>

<!-- ═══════════════════════════════════
     RESULT
     ═══════════════════════════════════ -->
<div id="result" style="display:none;min-height:100vh;align-items:center;justify-content:center;padding:2rem 1rem;flex-direction:column;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at center top,rgba(108,99,255,.15),transparent 60%);pointer-events:none;"></div>
  <div class="result-card">
    <span class="result-emoji" id="resultEmoji">🎉</span>
    <div class="result-score" id="resultScore">0%</div>
    <div class="result-label" id="resultLabel">Kết quả bài thi</div>
    <div class="integrity-badge" id="integrityBadge"></div>
    <div class="result-stats">
      <div class="result-stat correct">
        <div class="result-stat-val" id="rCorrect">0</div>
        <div class="result-stat-lbl">✅ Đúng</div>
      </div>
      <div class="result-stat incorrect">
        <div class="result-stat-val" id="rIncorrect">0</div>
        <div class="result-stat-lbl">❌ Sai</div>
      </div>
      <div class="result-stat skipped">
        <div class="result-stat-val" id="rSkipped">0</div>
        <div class="result-stat-lbl">⏭ Bỏ qua</div>
      </div>
    </div>
    <div class="review-list" id="reviewList"></div>
@@MANUAL_CONFLICT_4@@
  </div>
</div>

<!-- ═══════════════════════════════════
     RECORDS MODAL
     ═══════════════════════════════════ -->
<div id="recordsModal" class="modal-overlay" style="display:none;" onclick="closeModalBg(event)">
  <div class="modal-box">
@@MANUAL_CONFLICT_5@@
    </div>
    <div id="recordsContent"></div>
  </div>
</div>

<script src="js/googleSheet.js"></script>
<script src="js/gamification.js"></script>
<script src="js/quiz-engine.js"></script>
<script src="js/main.js"></script>
</body>
</html>